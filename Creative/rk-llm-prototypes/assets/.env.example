# Copy this file to .env (which is gitignored) and paste your real key in.
#   cp .env.example .env
# The proxy auto-detects a provider: Anthropic first, else the OpenAI-
# compatible block below. Uncomment ONE key line.

# (A) Anthropic — get a key at https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# (B) OpenAI-compatible (DeepSeek by default) — https://platform.deepseek.com/
# LLM_API_KEY=sk-your-deepseek-key-here
# DEEPSEEK_API_KEY=sk-your-deepseek-key-here   # alias for LLM_API_KEY

# Optional overrides (defaults shown; model/base URL default per provider):
# LLM_MODEL=claude-sonnet-5          # or deepseek-chat
# LLM_BASE_URL=https://api.anthropic.com/v1/messages   # or https://api.deepseek.com/chat/completions
# LLM_MAX_TOKENS=1024
# PORT=8787
